# Database Configuration
# Default to local SQLite database (uncomment/edit for PostgreSQL)
DATABASE_URL=sqlite:///./dewy.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Gemini API Key (Required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Channel Simulator Service URL
# When running with Docker Compose, use the service name
CHANNEL_SERVICE_URL=http://channel-service:8001
# CHANNEL_SERVICE_URL=http://localhost:8001

# Redis Configuration (Optional)
REDIS_URL=
