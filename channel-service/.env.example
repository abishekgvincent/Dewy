# Database Configuration
# Default to local SQLite database
DATABASE_URL=sqlite:///./channel_service.db

# CRM Callback URL (where delivery receipts and event logs are sent)
# When running with Docker Compose, use the service name
CRM_CALLBACK_URL=http://backend:8000/api/receipts
# CRM_CALLBACK_URL=http://localhost:8000/api/receipts

# Simulator Speed / Tuning Configurations
CALLBACK_TIMEOUT_SECONDS=10
DELIVERED_DELAY_SECONDS=2
OPENED_DELAY_SECONDS=5
READ_DELAY_SECONDS=8
CLICKED_DELAY_SECONDS=12
